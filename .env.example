# ===================================================
# Smart Hostel Allocation System - Environment Config
# ===================================================

# 1. Flask Secret Key (Required for sessions and cookie signing)
SECRET_KEY=smart_hostel_allocation_super_secret_key_sesd_2024

# 2. Flask Environment & Debug Mode
FLASK_ENV=production
FLASK_DEBUG=0

# 3. Database URL (Optional)
# If omitted or left empty, the application uses SQLite automatically:
# - Locally: database/hostel.db
# - On Vercel: /tmp/hostel.db
# If you connect an external database (e.g., Supabase, Neon, Neon Postgres), uncomment and set:
# DATABASE_URL=postgresql://username:password@ep-hostname.region.aws.neon.tech/neondb?sslmode=require

# 4. Port (Optional, default: 5000)
PORT=5000

